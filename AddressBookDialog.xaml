<Window x:Class="AddressPrinter.AddressBookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddressBook.Title}" Height="420" Width="460" ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        Icon="{DynamicResource AppIcon}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="AddressListBox" Grid.Row="0"
                 AutomationProperties.Name="{DynamicResource AddressBook.ListName}"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Name}"/>
                        <LineBreak/>
                        <Run Text="{Binding Street}" FontSize="12"/>
                        <LineBreak/>
                        <Run Text="{Binding ZipCity}" FontSize="12"/>
                        <LineBreak/>
                        <Run Text="{Binding Country}" FontSize="12"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="PrintButton" Content="{DynamicResource AddressBook.Print}" Width="100" Click="PrintButton_Click"/>
            <Button x:Name="DeleteButton" Content="{DynamicResource AddressBook.Delete}" Width="90" Margin="8,0,0,0" Click="DeleteButton_Click"/>
            <Button x:Name="CloseButton" Content="{DynamicResource AddressBook.Close}" Width="90" Margin="8,0,0,0" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
