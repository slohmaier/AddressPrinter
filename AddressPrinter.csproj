<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AddressPrinter</AssemblyName>
    <RootNamespace>AddressPrinter</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Description>Prints address, sender and #PORTO labels on a Phomemo M220 thermal printer.</Description>
    <Company>Stefan Lohmaier</Company>
    <Copyright>Copyright (c) 2026 Stefan Lohmaier</Copyright>
    <Product>AddressPrinter</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico"/>
  </ItemGroup>

  <Target Name="GenerateIcon" BeforeTargets="CoreCompile" Condition="!Exists('app.ico')">
    <Message Text="Generating app.ico from SVG..." Importance="high" />
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\Resources\gen_icon.py&quot; &quot;$(MSBuildProjectDirectory)\Resources\appicon.svg&quot; &quot;$(MSBuildProjectDirectory)\app.ico&quot;" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="IconExitCode" />
    </Exec>
    <Warning Text="Icon generation failed (install Pillow + skia-python). Using pre-committed app.ico." Condition="'$(IconExitCode)' != '0'" />
  </Target>

</Project>
