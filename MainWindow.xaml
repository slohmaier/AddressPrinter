<Window x:Class="AddressPrinter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MainWindow.Title}" Height="500" Width="520" MinHeight="440" MinWidth="420"
        Background="{DynamicResource WindowBgBrush}"
        Icon="pack://application:,,,/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{DynamicResource MainWindow.PrinterLabel}" VerticalAlignment="Center"/>
            <ComboBox x:Name="PrinterCombo" MinWidth="240" AutomationProperties.Name="{DynamicResource MainWindow.PrinterComboName}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,24">
            <Button x:Name="PrintPortoButton" Content="{DynamicResource MainWindow.PrintPorto}" Height="60"
                    Click="PrintPortoButton_Click" AutomationProperties.Name="{DynamicResource MainWindow.PrintPortoName}"/>
            <Button x:Name="PrintSenderButton" Content="{DynamicResource MainWindow.PrintSender}" Height="60"
                    Margin="0,16,0,0" Click="PrintSenderButton_Click"/>
            <Button x:Name="PrintAddressButton" Content="{DynamicResource MainWindow.PrintAddress}" Height="60"
                    Margin="0,16,0,0" Click="PrintAddressButton_Click"/>
            <Button x:Name="PrintFromBookButton" Content="{DynamicResource MainWindow.PrintFromBook}" Height="60"
                    Margin="0,16,0,0" Click="PrintFromBookButton_Click"
                    AutomationProperties.Name="{DynamicResource MainWindow.PrintFromBookName}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SettingsButton" Content="{DynamicResource MainWindow.Settings}" Click="SettingsButton_Click"
                    AutomationProperties.Name="{DynamicResource MainWindow.SettingsName}"/>
        </StackPanel>
    </Grid>
</Window>
