<Window x:Class="AddressPrinter.PortoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Porto.Title}" Height="220" Width="440" ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        Icon="pack://application:,,,/app.ico"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Porto.CodeLabel}" AutomationProperties.Name="{DynamicResource Porto.CodeLabelName}"/>
            <TextBox x:Name="CodeBox" Margin="0,8,0,0"
                     AutomationProperties.Name="{DynamicResource Porto.CodeBoxName}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="PrintButton" Content="{DynamicResource Porto.Print}" Width="90" Click="PrintButton_Click"/>
            <Button x:Name="CancelButton" Content="{DynamicResource Porto.Cancel}" Width="90" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
