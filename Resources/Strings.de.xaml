<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- MainWindow -->
    <sys:String x:Key="MainWindow.Title">AddressPrinter</sys:String>
    <sys:String x:Key="MainWindow.PrinterLabel">Drucker:</sys:String>
    <sys:String x:Key="MainWindow.PrinterComboName">Drucker auswählen</sys:String>
    <sys:String x:Key="MainWindow.PrintPorto">#PORTO drucken</sys:String>
    <sys:String x:Key="MainWindow.PrintPortoName">Porto Label drucken</sys:String>
    <sys:String x:Key="MainWindow.PrintSender">Drucke Absender (aus Einstellungen)</sys:String>
    <sys:String x:Key="MainWindow.PrintAddress">Drucke Adresse</sys:String>
    <sys:String x:Key="MainWindow.PrintFromBook">Drucken aus Adressbuch</sys:String>
    <sys:String x:Key="MainWindow.PrintFromBookName">Drucken aus Adressbuch</sys:String>
    <sys:String x:Key="MainWindow.Settings">Einstellungen…</sys:String>
    <sys:String x:Key="MainWindow.SettingsName">Einstellungen öffnen</sys:String>
    <sys:String x:Key="MainWindow.SenderMissingMsg">Es ist noch kein Absender hinterlegt. Bitte trage ihn unter Einstellungen ein.</sys:String>
    <sys:String x:Key="MainWindow.SenderMissingTitle">Absender fehlt</sys:String>

    <!-- SettingsWindow -->
    <sys:String x:Key="Settings.Title">Einstellungen</sys:String>
    <sys:String x:Key="Settings.GroupPrinter">Drucker</sys:String>
    <sys:String x:Key="Settings.PrinterComboName">Drucker auswählen</sys:String>
    <sys:String x:Key="Settings.GroupAppearance">Darstellung</sys:String>
    <sys:String x:Key="Settings.ThemeLabel">Design</sys:String>
    <sys:String x:Key="Settings.ThemeComboName">Design auswählen</sys:String>
    <sys:String x:Key="Settings.ThemeSystem">Folge System</sys:String>
    <sys:String x:Key="Settings.ThemeLight">Hell</sys:String>
    <sys:String x:Key="Settings.LanguageLabel">Sprache</sys:String>
    <sys:String x:Key="Settings.LanguageComboName">Sprache</sys:String>
    <sys:String x:Key="Settings.ThemeDark">Dunkel</sys:String>
    <sys:String x:Key="Settings.GroupSender">Absender</sys:String>
    <sys:String x:Key="Settings.SenderName">Name</sys:String>
    <sys:String x:Key="Settings.SenderNameBoxName">Name des Absenders</sys:String>
    <sys:String x:Key="Settings.SenderStreet">Straße und Hausnummer</sys:String>
    <sys:String x:Key="Settings.SenderStreetBoxName">Straße und Hausnummer des Absenders</sys:String>
    <sys:String x:Key="Settings.SenderZipCity">PLZ und Ort</sys:String>
    <sys:String x:Key="Settings.SenderZipCityBoxName">Postleitzahl und Ort des Absenders</sys:String>
    <sys:String x:Key="Settings.GroupLabelSize">Etikettengröße</sys:String>
    <sys:String x:Key="Settings.LabelWidth">Breite (mm)</sys:String>
    <sys:String x:Key="Settings.WidthBoxName">Etikettenbreite in Millimetern</sys:String>
    <sys:String x:Key="Settings.LabelHeight">Höhe (mm)</sys:String>
    <sys:String x:Key="Settings.HeightBoxName">Etikettenhöhe in Millimetern</sys:String>
    <sys:String x:Key="Settings.Save">Speichern</sys:String>
    <sys:String x:Key="Settings.Cancel">Abbrechen</sys:String>

    <!-- AddressDialog -->
    <sys:String x:Key="Address.Title">Adresse eingeben</sys:String>
    <sys:String x:Key="Address.Name">Name</sys:String>
    <sys:String x:Key="Address.NameBoxName">Name des Empfängers</sys:String>
    <sys:String x:Key="Address.Street">Straße und Hausnummer</sys:String>
    <sys:String x:Key="Address.StreetBoxName">Straße und Hausnummer des Empfängers</sys:String>
    <sys:String x:Key="Address.ZipCity">PLZ und Ort</sys:String>
    <sys:String x:Key="Address.ZipCityBoxName">Postleitzahl und Ort des Empfängers</sys:String>
    <sys:String x:Key="Address.Country">Land (optional)</sys:String>
    <sys:String x:Key="Address.CountryBoxName">Land des Empfängers, optional</sys:String>
    <sys:String x:Key="Address.SaveAndPrint">Drucken &amp; Speichern</sys:String>
    <sys:String x:Key="Address.Print">Drucken</sys:String>
    <sys:String x:Key="Address.Cancel">Abbrechen</sys:String>
    <sys:String x:Key="Address.ValidationMsg">Bitte fülle mindestens Name, Straße und PLZ/Ort aus.</sys:String>
    <sys:String x:Key="Address.ValidationTitle">Eingabe unvollständig</sys:String>

    <!-- PortoDialog -->
    <sys:String x:Key="Porto.Title">#PORTO drucken</sys:String>
    <sys:String x:Key="Porto.CodeLabel">DHL-Code (den du von DHL bekommst)</sys:String>
    <sys:String x:Key="Porto.CodeLabelName">DHL-Code eingeben</sys:String>
    <sys:String x:Key="Porto.CodeBoxName">DHL-Code für das Porto-Label</sys:String>
    <sys:String x:Key="Porto.Print">Drucken</sys:String>
    <sys:String x:Key="Porto.Cancel">Abbrechen</sys:String>

    <!-- AddressBookDialog -->
    <sys:String x:Key="AddressBook.Title">Adressbuch</sys:String>
    <sys:String x:Key="AddressBook.ListName">Gespeicherte Empfänger</sys:String>
    <sys:String x:Key="AddressBook.Print">Drucken</sys:String>
    <sys:String x:Key="AddressBook.Delete">Löschen</sys:String>
    <sys:String x:Key="AddressBook.Close">Schließen</sys:String>
    <sys:String x:Key="AddressBook.NoSelectionMsg">Bitte wähle zuerst eine Adresse aus der Liste.</sys:String>
    <sys:String x:Key="AddressBook.NoSelectionTitle">Keine Auswahl</sys:String>
    <sys:String x:Key="AddressBook.DeleteConfirm">„{0}“ wirklich aus dem Adressbuch löschen?</sys:String>
    <sys:String x:Key="AddressBook.DeleteTitle">Adresse löschen</sys:String>

</ResourceDictionary>
