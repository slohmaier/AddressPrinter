<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- MainWindow -->
    <sys:String x:Key="MainWindow.Title">AddressPrinter</sys:String>
    <sys:String x:Key="MainWindow.PrinterLabel">Printer:</sys:String>
    <sys:String x:Key="MainWindow.PrinterComboName">Select printer</sys:String>
    <sys:String x:Key="MainWindow.PrintPorto">Print #PORTO</sys:String>
    <sys:String x:Key="MainWindow.PrintPortoName">Print postage label</sys:String>
    <sys:String x:Key="MainWindow.PrintSender">Print sender (from settings)</sys:String>
    <sys:String x:Key="MainWindow.PrintAddress">Print address</sys:String>
    <sys:String x:Key="MainWindow.PrintFromBook">Print from address book</sys:String>
    <sys:String x:Key="MainWindow.PrintFromBookName">Print from address book</sys:String>
    <sys:String x:Key="MainWindow.Settings">Settings…</sys:String>
    <sys:String x:Key="MainWindow.SettingsName">Open settings</sys:String>
    <sys:String x:Key="MainWindow.SenderMissingMsg">No sender is configured yet. Please add one in the settings.</sys:String>
    <sys:String x:Key="MainWindow.SenderMissingTitle">Sender missing</sys:String>

    <!-- SettingsWindow -->
    <sys:String x:Key="Settings.Title">Settings</sys:String>
    <sys:String x:Key="Settings.GroupPrinter">Printer</sys:String>
    <sys:String x:Key="Settings.PrinterComboName">Select printer</sys:String>
    <sys:String x:Key="Settings.GroupAppearance">Appearance</sys:String>
    <sys:String x:Key="Settings.ThemeLabel">Theme</sys:String>
    <sys:String x:Key="Settings.ThemeComboName">Select theme</sys:String>
    <sys:String x:Key="Settings.ThemeSystem">Follow system</sys:String>
    <sys:String x:Key="Settings.ThemeLight">Light</sys:String>
    <sys:String x:Key="Settings.LanguageLabel">Language</sys:String>
    <sys:String x:Key="Settings.LanguageComboName">Language</sys:String>
    <sys:String x:Key="Settings.ThemeDark">Dark</sys:String>
    <sys:String x:Key="Settings.GroupSender">Sender</sys:String>
    <sys:String x:Key="Settings.SenderName">Name</sys:String>
    <sys:String x:Key="Settings.SenderNameBoxName">Sender name</sys:String>
    <sys:String x:Key="Settings.SenderStreet">Street and house number</sys:String>
    <sys:String x:Key="Settings.SenderStreetBoxName">Sender street and house number</sys:String>
    <sys:String x:Key="Settings.SenderZipCity">Postal code and city</sys:String>
    <sys:String x:Key="Settings.SenderZipCityBoxName">Sender postal code and city</sys:String>
    <sys:String x:Key="Settings.GroupLabelSize">Label size</sys:String>
    <sys:String x:Key="Settings.LabelWidth">Width (mm)</sys:String>
    <sys:String x:Key="Settings.WidthBoxName">Label width in millimetres</sys:String>
    <sys:String x:Key="Settings.LabelHeight">Height (mm)</sys:String>
    <sys:String x:Key="Settings.HeightBoxName">Label height in millimetres</sys:String>
    <sys:String x:Key="Settings.Save">Save</sys:String>
    <sys:String x:Key="Settings.Cancel">Cancel</sys:String>

    <!-- AddressDialog -->
    <sys:String x:Key="Address.Title">Enter address</sys:String>
    <sys:String x:Key="Address.Name">Name</sys:String>
    <sys:String x:Key="Address.NameBoxName">Recipient name</sys:String>
    <sys:String x:Key="Address.Street">Street and house number</sys:String>
    <sys:String x:Key="Address.StreetBoxName">Recipient street and house number</sys:String>
    <sys:String x:Key="Address.ZipCity">Postal code and city</sys:String>
    <sys:String x:Key="Address.ZipCityBoxName">Recipient postal code and city</sys:String>
    <sys:String x:Key="Address.Country">Country (optional)</sys:String>
    <sys:String x:Key="Address.CountryBoxName">Recipient country, optional</sys:String>
    <sys:String x:Key="Address.SaveAndPrint">Print &amp; Save</sys:String>
    <sys:String x:Key="Address.Print">Print</sys:String>
    <sys:String x:Key="Address.Cancel">Cancel</sys:String>
    <sys:String x:Key="Address.ValidationMsg">Please fill in at least name, street and postal code/city.</sys:String>
    <sys:String x:Key="Address.ValidationTitle">Incomplete input</sys:String>

    <!-- PortoDialog -->
    <sys:String x:Key="Porto.Title">Print #PORTO</sys:String>
    <sys:String x:Key="Porto.CodeLabel">DHL code (the one you get from DHL)</sys:String>
    <sys:String x:Key="Porto.CodeLabelName">Enter DHL code</sys:String>
    <sys:String x:Key="Porto.CodeBoxName">DHL code for the postage label</sys:String>
    <sys:String x:Key="Porto.Print">Print</sys:String>
    <sys:String x:Key="Porto.Cancel">Cancel</sys:String>

    <!-- AddressBookDialog -->
    <sys:String x:Key="AddressBook.Title">Address book</sys:String>
    <sys:String x:Key="AddressBook.ListName">Saved recipients</sys:String>
    <sys:String x:Key="AddressBook.Print">Print</sys:String>
    <sys:String x:Key="AddressBook.Delete">Delete</sys:String>
    <sys:String x:Key="AddressBook.Close">Close</sys:String>
    <sys:String x:Key="AddressBook.NoSelectionMsg">Please select an address from the list first.</sys:String>
    <sys:String x:Key="AddressBook.NoSelectionTitle">No selection</sys:String>
    <sys:String x:Key="AddressBook.DeleteConfirm">Really delete “{0}” from the address book?</sys:String>
    <sys:String x:Key="AddressBook.DeleteTitle">Delete address</sys:String>

</ResourceDictionary>
