<Window x:Class="AddressPrinter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}" Height="520" Width="480" ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBgBrush}"
        Icon="pack://application:,,,/app.ico"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <GroupBox Header="{DynamicResource Settings.GroupPrinter}">
            <StackPanel Margin="8">
                <ComboBox x:Name="PrinterCombo" AutomationProperties.Name="{DynamicResource Settings.PrinterComboName}"
                          MinWidth="300" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{DynamicResource Settings.GroupAppearance}" Margin="0,12,0,0">
            <StackPanel Margin="8">
                <TextBlock Text="{DynamicResource Settings.ThemeLabel}"/>
                <ComboBox x:Name="ThemeCombo" AutomationProperties.Name="{DynamicResource Settings.ThemeComboName}"
                          MinWidth="200" HorizontalAlignment="Left" Margin="0,2,0,0">
                    <ComboBoxItem Content="{DynamicResource Settings.ThemeSystem}" Tag="system"/>
                    <ComboBoxItem Content="{DynamicResource Settings.ThemeLight}" Tag="light"/>
                    <ComboBoxItem Content="{DynamicResource Settings.ThemeDark}" Tag="dark"/>
                </ComboBox>
                <TextBlock Text="{DynamicResource Settings.LanguageLabel}" Margin="0,10,0,0"/>
                <ComboBox x:Name="LanguageCombo" AutomationProperties.Name="{DynamicResource Settings.LanguageComboName}"
                          MinWidth="200" HorizontalAlignment="Left" Margin="0,2,0,0">
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="Deutsch" Tag="de"/>
                    <ComboBoxItem Content="Español" Tag="es"/>
                    <ComboBoxItem Content="Français" Tag="fr"/>
                    <ComboBoxItem Content="Italiano" Tag="it"/>
                    <ComboBoxItem Content="日本語" Tag="ja"/>
                    <ComboBoxItem Content="Nederlands" Tag="nl"/>
                    <ComboBoxItem Content="Português" Tag="pt"/>
                </ComboBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{DynamicResource Settings.GroupSender}" Margin="0,12,0,0">
            <StackPanel Margin="8">
                <TextBlock Text="{DynamicResource Settings.SenderName}"/>
                <TextBox x:Name="SenderNameBox" Margin="0,2,0,8"
                         AutomationProperties.Name="{DynamicResource Settings.SenderNameBoxName}"/>
                <TextBlock Text="{DynamicResource Settings.SenderStreet}"/>
                <TextBox x:Name="SenderStreetBox" Margin="0,2,0,8"
                         AutomationProperties.Name="{DynamicResource Settings.SenderStreetBoxName}"/>
                <TextBlock Text="{DynamicResource Settings.SenderZipCity}"/>
                <TextBox x:Name="SenderZipCityBox" Margin="0,2,0,0"
                         AutomationProperties.Name="{DynamicResource Settings.SenderZipCityBoxName}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{DynamicResource Settings.GroupLabelSize}" Margin="0,12,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource Settings.LabelWidth}"/>
                    <TextBox x:Name="WidthBox" AutomationProperties.Name="{DynamicResource Settings.WidthBoxName}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Settings.LabelHeight}"/>
                    <TextBox x:Name="HeightBox" AutomationProperties.Name="{DynamicResource Settings.HeightBoxName}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="{DynamicResource Settings.Save}" Width="90" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="{DynamicResource Settings.Cancel}" Width="90" Margin="8,0,0,0" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
